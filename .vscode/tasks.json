{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "launch-helm-controller",
      "type": "process",
      "command": "py",
      "args": [
        "-3",
        "-m",
        "helm_controller",
        "--workspace",
        "${workspaceFolder}"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/controller/src"
        }
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
