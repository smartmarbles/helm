      "grep_search",
      "file_search",
      "read_file",
      "list_dir",
      "get_errors",
      "vscode_listCodeUsages",
      "copilot_getNotebookSummary",
      "read_notebook_cell_output",
      "terminal_selection",
      "terminal_last_command",
      "get_terminal_output",
      "get_task_output",
      "testFailure",
      "view_image"
    ],
    "workflow_state": [
      "session_store_sql"
    ],
    "agent_dispatch": [
      "runSubagent"
    ],
    "file_mutation": [
      {"name": "create_file", "path_fields": ["filePath"]},
      {"name": "replace_string_in_file", "path_fields": ["filePath"]},
